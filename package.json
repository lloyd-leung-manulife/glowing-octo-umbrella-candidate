{
  "name": "returnflow-qe-assessment",
  "private": true,
  "version": "1.0.0",
  "description": "Automation QE candidate assessment package (ReturnFlow retail return-request portal)",
  "scripts": {
    "test": "playwright test",
    "test:dev": "cross-env TEST_ENV=dev playwright test",
    "test:uat": "cross-env TEST_ENV=uat playwright test",
    "test:prod": "cross-env TEST_ENV=prod playwright test",
    "test:ui": "cross-env TEST_ENV=dev playwright test --ui",
    "test:ui:dev": "cross-env TEST_ENV=dev playwright test --ui",
    "test:ui:uat": "cross-env TEST_ENV=uat playwright test --ui",
    "test:ui:prod": "cross-env TEST_ENV=prod playwright test --ui",
    "test:report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.0",
    "cross-env": "^10.1.0"
  }
}
